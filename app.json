{
  "expo": {
    "name": "Biso Livraison",
    "slug": "biso-livraison",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#002774",
    "splash": {
      "image": "./assets/splash-background.png",
      "resizeMode": "cover",
      "backgroundColor": "#002774"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#002774",
          "image": "./assets/splash-background.png",
          "resizeMode": "cover"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Biso Livraison utilise votre position pour calculer la distance et les frais de livraison, et trouver les restaurants et livreurs près de vous."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FE6400"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Biso Livraison utilise votre position pour calculer la distance et les frais de livraison, et trouver les restaurants et livreurs près de vous.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "bundleIdentifier": "com.helloim.biso-livraison"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#002774",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
